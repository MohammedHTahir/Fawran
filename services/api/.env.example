DATABASE_URL=postgres://fawran:fawran@localhost:5432/fawran
JWT_SECRET=change-me-in-production
# Required in production; use a separate random secret of at least 32 characters.
OTP_PEPPER=change-me-use-a-random-secret-in-production
# Optional production SMS via Twilio; use only after Egypt sender registration/approval.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Set one of Messaging Service SID or a registered sender ID/number.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM=
# Optional HTTPS delivery-status callback URL (endpoint must be implemented and secured before use).
TWILIO_STATUS_CALLBACK_URL=
NODE_ENV=development
PORT=3000
# Ledger provider: postgres (default) or blnk. Keep postgres until Blnk is fully configured.
LEDGER_PROVIDER=postgres
BLNK_BASE_URL=http://127.0.0.1:5001
BLNK_LEDGER_ID=
BLNK_SYSTEM_BALANCE_ID=
# Required only when Blnk secure mode is enabled.
BLNK_API_KEY=
BLNK_SECURE_MODE=false
